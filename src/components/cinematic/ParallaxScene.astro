---
// Multi-Layer Depth Parallax Scene Component (Reference Panel 8)
---

<section id="parallax-depth-scene" class="parallax-section" aria-label="Cinematic Layered Depth Scene">
  <div class="parallax-viewport">
    <!-- Layer 1: Background Mountains (Slow Velocity: 0.15x) -->
    <div class="parallax-layer layer-bg" data-speed="0.15">
      <img 
        src="/images/parallax-scene.jpg" 
        alt="Mountain peaks at dusk" 
        class="parallax-img img-bg"
        loading="lazy"
        decoding="async"
      />
      <div class="layer-overlay-tint"></div>
    </div>

    <!-- Layer 2: Midground Atmosphere & Silhouettes (Medium Velocity: 0.45x) -->
    <div class="parallax-layer layer-mid" data-speed="0.45">
      <div class="ambient-mist-particle-band"></div>
    </div>

    <!-- Layer 3: Foreground Floating Typographic Poetry (Fast Velocity: 1.05x) -->
    <div class="parallax-layer layer-fg" data-speed="1.05">
      <div class="cinematic-container">
        <div class="layered-quote-block">
          <span class="layered-kicker">A Quiet Horizon</span>
          <h2 class="layered-title">Two Souls, One Endless Skyline</h2>
          <p class="layered-caption">"In the quiet of the Rajasthan hills, we discovered that home wasn't a place, but a presence."</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .parallax-section {
    position: relative;
    width: 100vw;
    height: 90vh;
    min-height: 650px;
    overflow: hidden;
    background-color: var(--surface-void);
    z-index: var(--z-photography);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .parallax-viewport {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .parallax-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    will-change: transform;
    pointer-events: none;
  }

  .layer-bg {
    z-index: 1;
    transform: scale(1.15);
  }

  .parallax-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    filter: brightness(0.65) contrast(1.1);
  }

  .layer-overlay-tint {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(8, 11, 13, 0.95) 0%,
      rgba(8, 11, 13, 0.2) 40%,
      rgba(8, 11, 13, 0.3) 60%,
      rgba(8, 11, 13, 0.95) 100%
    );
  }

  .layer-mid {
    z-index: 2;
  }

  .ambient-mist-particle-band {
    position: absolute;
    bottom: 20%;
    left: 0;
    width: 100%;
    height: 250px;
    background: radial-gradient(
      ellipse at center,
      rgba(215, 198, 165, 0.08) 0%,
      transparent 75%
    );
    filter: blur(30px);
  }

  .layer-fg {
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: auto;
  }

  .layered-quote-block {
    text-align: center;
    max-width: 850px;
    margin: 0 auto;
    padding: 3rem 2rem;
    background: rgba(18, 21, 24, 0.65);
    border: 1px solid var(--border-fine);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: var(--shadow-cinematic-deep);
  }

  .layered-kicker {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    color: var(--text-gold);
    text-transform: uppercase;
    margin-bottom: 1rem;
    display: block;
  }

  .layered-title {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    letter-spacing: 0.15em;
    color: var(--text-hero);
    margin-bottom: 1.25rem;
    line-height: 1.2;
  }

  .layered-caption {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--text-gold-light);
    font-style: italic;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .parallax-section {
      height: 75vh;
    }
    .layered-quote-block {
      padding: 2rem 1.25rem;
    }
  }
</style>

<script>
  function initParallaxPhysics() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const section = document.getElementById('parallax-depth-scene');
    if (!section) return;

    const layers = section.querySelectorAll('.parallax-layer') as NodeListOf<HTMLElement>;

    window.addEventListener('scroll', () => {
      const rect = section.getBoundingClientRect();
      const windowHeight = window.innerHeight;

      // Only calculate if visible on screen
      if (rect.top <= windowHeight && rect.bottom >= 0) {
        const progress = (windowHeight - rect.top) / (windowHeight + rect.height);
        const offsetCenter = (progress - 0.5) * 2; // -1 to 1

        layers.forEach((layer) => {
          const speed = parseFloat(layer.getAttribute('data-speed') || '0.5');
          const yOffset = offsetCenter * speed * 70;
          layer.style.transform = `translate3d(0, ${yOffset}px, 0)`;
        });
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initParallaxPhysics);
</script>
