---
// Floating Warm Gold Particle Field (Canvas-based)
---

<canvas id="particle-field" class="particle-canvas" aria-hidden="true"></canvas>

<style>
  .particle-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: var(--z-atmosphere);
  }
</style>

<script>
  function initParticleField() {
    const canvas = document.getElementById('particle-field') as HTMLCanvasElement;
    if (!canvas) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    window.addEventListener('resize', () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    });

    const particleCount = window.innerWidth < 768 ? 20 : 45;
    const particles: Array<{
      x: number;
      y: number;
      size: number;
      speedY: number;
      speedX: number;
      alpha: number;
      maxAlpha: number;
      pulseSpeed: number;
      scrollInfluence: number;
    }> = [];

    for (let i = 0; i < particleCount; i++) {
      particles.push({
        x: Math.random() * width,
        y: Math.random() * height,
        size: Math.random() * 2.0 + 0.6,
        speedY: -(Math.random() * 0.3 + 0.1),
        speedX: (Math.random() - 0.5) * 0.2,
        alpha: Math.random() * 0.4,
        maxAlpha: Math.random() * 0.6 + 0.2,
        pulseSpeed: Math.random() * 0.015 + 0.005,
        scrollInfluence: Math.random() * 0.8 + 0.3,
      });
    }

    // Scroll Velocity Tracker
    let lastScrollY = window.scrollY;
    let scrollVelocity = 0;
    let targetVelocity = 0;

    window.addEventListener('scroll', () => {
      const currentScrollY = window.scrollY;
      const delta = currentScrollY - lastScrollY;
      targetVelocity = delta * 0.12;
      lastScrollY = currentScrollY;
    }, { passive: true });

    function render() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      // Smooth dampening on scroll velocity
      scrollVelocity += (targetVelocity - scrollVelocity) * 0.1;
      targetVelocity *= 0.92; // Decay

      particles.forEach((p) => {
        // Apply scroll-driven inertia to particles
        p.y += p.speedY - (scrollVelocity * p.scrollInfluence);
        p.x += p.speedX + (scrollVelocity * 0.05 * (p.x > width / 2 ? 1 : -1));
        p.alpha += p.pulseSpeed;

        if (p.alpha > p.maxAlpha || p.alpha < 0.1) {
          p.pulseSpeed = -p.pulseSpeed;
        }

        // Wrap around boundaries
        if (p.y < -10) {
          p.y = height + 10;
          p.x = Math.random() * width;
        }
        if (p.y > height + 10) {
          p.y = -10;
          p.x = Math.random() * width;
        }
        if (p.x < 0) p.x = width;
        if (p.x > width) p.x = 0;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(215, 198, 165, ${Math.max(0, p.alpha)})`;
        ctx.shadowBlur = 8;
        ctx.shadowColor = 'rgba(234, 217, 178, 0.5)';
        ctx.fill();
      });

      requestAnimationFrame(render);
    }

    render();
  }

  document.addEventListener('DOMContentLoaded', initParticleField);
</script>
