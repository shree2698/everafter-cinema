---
// Relationship Timeline / Memory Reel Component (Reference Panel 5)
import { weddingData } from '../../data/weddingContent';
---

<section id="timeline" class="timeline-section cinematic-section-flow" aria-label="Our Journey Timeline">
  <div class="cinematic-container">
    <div class="timeline-header">
      <span class="timeline-kicker">Chapter II — The Journey</span>
      <h2 class="timeline-title">Milestones of Forever</h2>
      <p class="timeline-subtitle">The path that brought us together through the years</p>
    </div>

    <!-- Timeline Grid / Strip -->
    <div class="timeline-track-wrap">
      <div class="timeline-connector-line"></div>

      <div class="timeline-nodes-grid">
        {weddingData.timelineMilestones.map((milestone, idx) => (
          <div class="timeline-node" data-cursor="view" data-cursor-label="RECALL">
            <div class="node-year-badge">
              <span class="node-year">{milestone.year}</span>
              <span class="node-title">{milestone.title}</span>
            </div>

            <div class="node-dot-anchor">
              <span class="dot-inner"></span>
            </div>

            <div class="node-photo-card">
              <div class="node-img-wrap">
                <img 
                  src={milestone.image} 
                  alt={milestone.title} 
                  class="node-img"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="node-meta">
                <span class="node-loc">{milestone.location}</span>
                <p class="node-desc">{milestone.description}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .timeline-section {
    position: relative;
    padding: 8rem 0;
    background-color: var(--surface-base);
    z-index: var(--z-content);
    overflow: hidden;
  }

  .timeline-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 5rem;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 1s var(--ease-cinematic-out), transform 1s var(--ease-cinematic-out);
  }
  .timeline-header.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  .timeline-kicker {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    color: var(--text-gold);
    text-transform: uppercase;
    display: block;
    margin-bottom: 1rem;
  }

  .timeline-title {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    letter-spacing: 0.15em;
    margin-bottom: 1rem;
  }

  .timeline-subtitle {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--text-muted);
    font-style: italic;
  }

  .timeline-track-wrap {
    position: relative;
    padding-top: 2rem;
  }

  .timeline-connector-line {
    position: absolute;
    top: 5.5rem;
    left: 0;
    width: 0%;
    height: 2px;
    background: linear-gradient(
      to right,
      var(--accent-bronze),
      var(--accent-gold) 50%,
      var(--accent-rose-gold)
    );
    box-shadow: 0 0 12px rgba(215, 198, 165, 0.4);
    transition: width 1.8s var(--ease-editorial-expo);
    z-index: 1;
  }
  .timeline-connector-line.active-line {
    width: 100%;
  }

  .timeline-nodes-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1.25rem;
    position: relative;
    z-index: 2;
  }

  .timeline-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    opacity: 0;
    transform: translateY(40px) scale(0.95);
    transition: opacity 0.9s var(--ease-cinematic-out),
                transform 0.9s var(--ease-cinematic-out),
                filter 0.9s ease;
  }

  .timeline-node.node-revealed {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .node-year-badge {
    margin-bottom: 1.25rem;
    transition: transform 0.4s ease;
  }

  .node-year {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    color: var(--text-gold-light);
    display: block;
    letter-spacing: 0.1em;
  }

  .node-title {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .node-dot-anchor {
    position: relative;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background-color: var(--surface-void);
    border: 2px solid var(--accent-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    z-index: 3;
    transition: transform 0.4s var(--ease-cinematic-out),
                border-color 0.4s ease,
                box-shadow 0.4s ease;
  }

  .dot-inner {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent-rose-gold);
    transition: transform 0.3s ease, background-color 0.3s ease;
  }

  .timeline-node:hover .node-dot-anchor,
  .timeline-node.node-active .node-dot-anchor {
    transform: scale(1.35);
    border-color: var(--accent-gold-hover);
    box-shadow: 0 0 20px rgba(234, 217, 178, 0.6);
  }

  .timeline-node:hover .dot-inner,
  .timeline-node.node-active .dot-inner {
    transform: scale(1.3);
    background-color: var(--text-hero);
  }

  .node-photo-card {
    background: var(--surface-elevated-2);
    border: 1px solid var(--border-whisper);
    padding: 0.75rem;
    width: 100%;
    box-shadow: var(--shadow-cinematic-deep);
    transition: transform 0.6s var(--ease-cinematic-out),
                border-color 0.4s ease,
                box-shadow 0.6s ease;
  }

  .timeline-node:hover .node-photo-card {
    transform: translateY(-8px);
    border-color: var(--border-accent);
    box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.8), 0 0 25px rgba(215, 198, 165, 0.15);
  }

  .node-img-wrap {
    width: 100%;
    aspect-ratio: 4/5;
    overflow: hidden;
    margin-bottom: 0.75rem;
    background-color: var(--surface-void);
  }

  .node-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.82) contrast(1.05);
    transition: transform 1.2s var(--ease-cinematic-out), filter 0.8s ease;
  }

  .timeline-node:hover .node-img {
    transform: scale(1.08);
    filter: brightness(0.98) contrast(1.08);
  }

  .node-meta {
    padding: 0 0.25rem;
  }

  .node-loc {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    color: var(--accent-gold);
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.35rem;
  }

  .node-desc {
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  @media (max-width: 1024px) {
    .timeline-nodes-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
    .timeline-connector-line {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .timeline-nodes-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>

<script>
  function initTimelineScrollAnimation() {
    const section = document.getElementById('timeline');
    if (!section) return;

    const header = section.querySelector('.timeline-header');
    const line = section.querySelector('.timeline-connector-line');
    const nodes = section.querySelectorAll('.timeline-node');

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            // 1. Reveal Header
            header?.classList.add('revealed');

            // 2. Expand Gold Progress Track
            setTimeout(() => {
              line?.classList.add('active-line');
            }, 300);

            // 3. Stagger Roadmap Nodes One by One
            nodes.forEach((node, idx) => {
              setTimeout(() => {
                node.classList.add('node-revealed');
                // Highlight active pulse briefly
                node.classList.add('node-active');
                setTimeout(() => node.classList.remove('node-active'), 800);
              }, 600 + idx * 280); // Stagger interval of 280ms
            });

            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2 }
    );

    observer.observe(section);
  }

  document.addEventListener('DOMContentLoaded', initTimelineScrollAnimation);
</script>
