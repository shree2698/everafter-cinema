---
// 4-Part Chapter Scroll Storytelling Section (Reference Panel 3)
import { weddingData } from '../../data/weddingContent';
---

<section id="story-prologue" class="story-section" aria-label="Our Story Chapters">
  <div class="cinematic-container">
    <div class="story-header">
      <span class="story-kicker">Chapter I — The Beginning</span>
      <h2 class="story-title">How Our Worlds Aligned</h2>
      <p class="story-intro">Every great story is written in quiet, unexpected moments.</p>
    </div>

    <!-- 4-Chapter Scene Panels -->
    <div class="story-chapters-grid">
      {weddingData.storyScenes.map((scene) => (
        <div class="story-chapter-card" data-cursor="view" data-cursor-label="DISCOVER">
          <div class="chapter-image-wrap">
            <img 
              src={scene.image} 
              alt={scene.headline} 
              class="chapter-img"
              loading="lazy"
              decoding="async"
            />
            <div class="chapter-overlay"></div>
          </div>

          <div class="chapter-info">
            <span class="chapter-number">{scene.sceneNumber}</span>
            <h3 class="chapter-headline">{scene.headline}</h3>
            <p class="chapter-subtext">{scene.subtext}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .story-section {
    position: relative;
    padding: 8rem 0;
    background-color: var(--surface-void);
    z-index: var(--z-content);
  }

  .story-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 5rem;
  }

  .story-kicker {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    color: var(--text-gold);
    text-transform: uppercase;
    display: block;
    margin-bottom: 1rem;
  }

  .story-title {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    letter-spacing: 0.15em;
    margin-bottom: 1rem;
  }

  .story-intro {
    font-size: 1.05rem;
    color: var(--text-muted);
    font-style: italic;
    font-family: var(--font-serif);
  }

  .story-chapters-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .story-chapter-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface-elevated-2);
    border: 1px solid var(--border-whisper);
    overflow: hidden;
    transition: transform 0.6s var(--ease-cinematic-out),
                border-color 0.4s ease,
                box-shadow 0.6s var(--ease-cinematic-out);
  }

  .story-chapter-card:hover {
    transform: translateY(-8px);
    border-color: var(--border-accent);
    box-shadow: var(--shadow-card-hover);
  }

  .chapter-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4/5;
    overflow: hidden;
  }

  .chapter-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.8) contrast(1.05);
    transition: transform 1.2s var(--ease-cinematic-out),
                filter 0.8s ease;
  }

  .story-chapter-card:hover .chapter-img {
    transform: scale(1.06);
    filter: brightness(0.95) contrast(1.08);
  }

  .chapter-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 40%,
      rgba(8, 11, 13, 0.95) 100%
    );
  }

  .chapter-info {
    position: relative;
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .chapter-number {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--accent-gold);
    letter-spacing: 0.2em;
    margin-bottom: 0.75rem;
  }

  .chapter-headline {
    font-size: 1.25rem;
    line-height: 1.35;
    letter-spacing: 0.1em;
    color: var(--text-hero);
    margin-bottom: 0.75rem;
  }

  .chapter-subtext {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-top: auto;
  }

  @media (max-width: 1024px) {
    .story-chapters-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }

  @media (max-width: 640px) {
    .story-chapters-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
