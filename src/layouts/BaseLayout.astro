---
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Arjun & Meera — A Story Worth Remembering | 18.12.2026",
  description = "An interactive cinematic love story and wedding celebration of Arjun and Meera at The Grand Taj Palace, Udaipur."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Montserrat:wght@200;300;400;500;600&family=Pinyon+Script&display=swap"
      rel="stylesheet"
    />

    <!-- SEO & Social Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://arjunandmeera.com/" />
    <meta name="theme-color" content="#080B0D" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://arjunandmeera.com/" />
    <meta property="og:image" content="/images/hero-couple-main.jpg" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Structured Data (schema.org Event) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Event",
        "name": "Arjun & Meera Wedding Celebration",
        "startDate": "2026-12-18T11:30:00+05:30",
        "endDate": "2026-12-22T23:59:00+05:30",
        "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
        "eventStatus": "https://schema.org/EventScheduled",
        "location": {
          "@type": "Place",
          "name": "The Grand Taj Palace",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Udaipur",
            "addressRegion": "Rajasthan",
            "addressCountry": "India"
          }
        },
        "image": [
          "/images/hero-couple-main.jpg",
          "/images/venue-taj-palace.jpg"
        ],
        "description": "An interactive cinematic love story and wedding celebration of Arjun and Meera."
      }
    </script>

    <!-- Global Styles -->
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body>
    <slot />

    <!-- Client-side Smooth Scroll & Animation Initialization -->
    <script>
      import { initSmoothScroll } from '../scripts/lenisScroll';
      import { initSectionTransitions } from '../scripts/sectionTransitions';
      import '../scripts/gsapSetup';

      // Initialize Lenis & Section Choreography
      document.addEventListener('DOMContentLoaded', () => {
        initSmoothScroll();
        initSectionTransitions();
      });
    </script>
  </body>
</html>
